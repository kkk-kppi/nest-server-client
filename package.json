{
  "name": "nest-server-client",
  "author": {
    "name": "lazason",
    "email": "lazason@foxmail.com"
  },
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx,.vue && stylelint \"src/**/*.{css,scss}\"",
    "lint:fix": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx,.vue --fix && stylelint \"src/**/*.{css,scss}\" --fix",
    "format": "prettier . --write",
    "check:branch-name": "node scripts/validate-branch-name.mjs",
    "commitlint": "commitlint",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:api": "pnpm typecheck && pnpm exec vitest run src/core/http/ src/mocks/ api.test.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:codegen": "playwright codegen http://localhost:5173",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@sentry/vue": "^10.54.0",
    "axios": "^1.13.1",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.30",
    "vue-i18n": "^11.4.4",
    "vue-router": "^4.6.3",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "1.60.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-onboarding": "^10.4.1",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/vue3-vite": "^10.4.1",
    "@types/node": "^24.12.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.4.1",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.2.3",
    "msw": "^2.12.14",
    "playwright": "^1.60.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.4.1",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
