{
  "name": "nest-server-client",
  "author": {
    "name": "lazason",
    "email": "lazason@foxmail.com"
  },
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx,.vue && stylelint \"src/**/*.{css,scss}\"",
    "lint:fix": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx,.vue --fix && stylelint \"src/**/*.{css,scss}\" --fix",
    "format": "prettier . --write",
    "check:branch-name": "node scripts/validate-branch-name.mjs",
    "commitlint": "commitlint",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:api": "pnpm typecheck && pnpm exec vitest run src/core/http/ src/mocks/ api.test.ts",
    "e2e:open": "cypress open",
    "e2e:run": "cypress run --e2e --browser electron",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sentry/vue": "^10.54.0",
    "axios": "^1.13.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.30",
    "vue-router": "^4.6.3",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^24.12.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "cypress": "^15.13.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.2.3",
    "msw": "^2.12.14",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
